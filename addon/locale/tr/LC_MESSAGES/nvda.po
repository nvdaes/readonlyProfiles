#. Translators: Message presented in input help mode.
#: addon\globalPlugins\readonlyProfiles.py:35
msgid "Saves the current configuration to the most recent profile"
msgstr "Geçerli konfigürasyonu en son profile kaydeder"

#. Translators: Message presented when the user tries to save normal configuration.
#: addon\globalPlugins\readonlyProfiles.py:43
msgid "Normal configuration cannot be saved with this command"
msgstr "Normal konfigürasyon bu komutla kaydedilemez"

#. Translators: Message presented when a profile is saved.
#: addon\globalPlugins\readonlyProfiles.py:47
#, python-brace-format
msgid "Saved profile: {profile}"
msgstr "Kaydedilen profil: {profile}"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "Readonly Profiles"
msgstr "Salt Okunur Profiller"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Don't save profiles automatically. Press NVDA+shift+p to save the most recent profile."
msgstr "Profiller otomatik olarak kaydedilmedi. En son profili kaydetmek için NVDA+shift+p tuşlarına basın."

